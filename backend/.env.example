# AI Wallet Guard backend settings
# Copy to .env and fill the required values. NEVER commit .env.

# Sepolia blockchain
PRIVATE_KEY=
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=
EXPLORER_URL=https://sepolia.etherscan.io

# Frontend CORS
FRONTEND_ORIGIN=*

# Security threshold
HIGH_VALUE_ETH=0.5

# Optional AI provider. Leave API_KEY empty for deterministic demo explanations.
API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
